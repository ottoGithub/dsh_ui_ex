{
  "name": "@local/dsh-ui-ex",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek Harness UI enhancements in one bundle: workspace recency order and pinning, and opening a folder from the Windows Explorer context menu.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "assets",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ui",
    "sidebar",
    "workspace",
    "windows",
    "explorer"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}

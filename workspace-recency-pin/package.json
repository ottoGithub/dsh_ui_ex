{
  "name": "@local/dsh-workspace-recency-pin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sorts the sidebar's workspaces by their most recent session activity and adds a pin action that keeps pinned workspaces at the top.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
